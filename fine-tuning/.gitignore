node_modules/
dist/
.vite/
.cache/
embeddings/

# Packed dataset payloads are large and often licence-restricted. Only the
# index/manifest files are tracked -- see public/datasets/README.md.
public/datasets/**/*.png
public/datasets/**/*.jpg
public/datasets/**/*.bin

# build artefacts from the Python pipeline (large, and dataset-licence bound)
scripts/__pycache__/
public/embeddings/**/*.f32
public/heads/**/*.f32
public/parity/reference.json
datasets/

# generated video assets
public/video/*.mp4

# The exported backbone (~102 MB) and onnxruntime's WASM (~11 MB). Both are
# reproducible: `python scripts/export_backbone.py` and `node scripts/copy_ort.mjs`
# (the latter runs on npm install). Committing 113 MB of regenerable binary to
# teach a lesson about fine-tuning would be its own kind of joke.
public/models/**/*.onnx
public/ort/

# Parity fixtures -- regenerated by check_parity.py, and they embed copies of
# licence-bound source images.
public/parity/
